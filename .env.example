# Copy to .env
DATABASE_URL=postgres://mera:mera@localhost:5432/mera
# DB_SSL: leave unset for hosted Postgres (Neon/Supabase need SSL).
# Set DB_SSL=off only for a LOCAL Postgres without SSL.
# DB_SSL=off
# Dev fallback: if DATABASE_URL missing, uses ./dev.sqlite
JWT_SECRET=change-me-mera-secret
PORT=3000
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
# Mail — welcome email on subscribe. Pick ONE (Resend is easiest, free):
# 1) Resend: sign up at resend.com, verify domain, paste key:
RESEND_API_KEY=
# 2) or SMTP (Gmail app-password, etc.):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MERA <hello@mera.shop>
FRONTEND_URL=http://localhost:3001
# Admin seed (used on API boot if no admin exists)
ADMIN_EMAIL=admin@mera.shop
ADMIN_PASSWORD=MeraAdmin123!
# WhatsApp click-to-chat number (no +, no spaces). Frontend: NEXT_PUBLIC_WHATSAPP=96181580436
